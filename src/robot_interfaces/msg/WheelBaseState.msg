# 底盘状态黑板；header.stamp为快照组装时间，两轮实际采样时间见各自header。
std_msgs/Header header
# 每次进程/设备会话重建更换session_id；序号只在对应会话内比较。
string backend
string operation_mode
string session_id
string configuration_digest
uint64 state_sequence
uint64 fault_sequence
uint8 UNCONFIGURED=0
uint8 DISABLED=1
uint8 ENABLING=2
uint8 READY=3
uint8 MOVING=4
uint8 STOPPING=5
uint8 FAULT=6
uint8 lifecycle_state
robot_interfaces/WheelMotorState left
robot_interfaces/WheelMotorState right
bool motion_authorized
bool command_fresh
bool odometry_valid
bool standstill_confirmed
bool parking_confirmed
bool arm_operation_permitted
# UNKNOWN不能解释为急停已释放；软件服务不是实体急停。
uint8 ESTOP_UNKNOWN=0
uint8 ESTOP_RELEASED=1
uint8 ESTOP_ASSERTED=2
uint8 emergency_stop_state
# 会话内左右有符号行程；path为累计路程而非起点净位移。未知值NaN。
float64 left_travel_m
float64 right_travel_m
float64 base_path_length_m
# 最后一个异步管理操作；完整事件流见WheelControlEvent。
string last_request_id
uint8 REQUEST_NONE=0
uint8 REQUEST_PENDING=1
uint8 REQUEST_SUCCEEDED=2
uint8 REQUEST_FAILED=3
uint8 REQUEST_CANCELLED=4
uint8 last_request_state
string reason
# 相对任务：结果通过get_control_result查询。结束后保留最后一次的反馈误差。
bool relative_motion_active
string relative_request_id
uint8 relative_kind
float64 relative_target
float64 relative_measured
float64 relative_error
float64[2] relative_wheel_target_rad
float64[2] relative_wheel_travel_rad

# 每动作绝对轮路程，含停车；不是净位移。0上限表示该模式无调试预算。
float64[2] action_wheel_travel_m
float64 action_distance_limit_m
float64 relative_timeout_s
