# H55单轮测量快照，所有浮点未知值使用NaN，不能使用默认0冒充有效反馈。
# header.stamp为该样本主机接收ROS时间，不是CAN硬件时间；重发快照不刷新它。
std_msgs/Header header
string joint_name
uint64 sample_sequence
uint16 can_id
uint16 master_id
uint8 control_mode
int8 direction
bool feedback_valid
bool continuous_position_valid
bool identity_verified
bool driver_enabled
# 原始状态码按H55协议解释；无有效反馈时raw_state_code无效。
uint8 raw_state_code
# 相对于发布/查询时刻，按steady_clock计算，不由ROS时间相减。
builtin_interfaces/Duration feedback_age
float64 raw_position_rad
float64 raw_velocity_rad_s
# 逻辑正方向统一为驱动底盘前进；continuous_position为会话内连续角度。
float64 continuous_position_rad
float64 velocity_rad_s
float64 target_velocity_rad_s
# 驱动器报告的扭矩估计，不等同于经校准的独立扭矩传感器。
float64 reported_torque_nm
float64 driver_temperature_c
float64 motor_temperature_c
